{
  "name": "ironveil",
  "version": "0.2.0",
  "description": "An opinionated developer productivity CLI for bootstrapping production-ready NestJS backends.",
  "type": "module",
  "bin": {
    "ironveil": "./bin/ironveil.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "tsx src/index.ts",
    "prepack": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/unit",
    "test:watch": "vitest test/unit",
    "test:e2e": "vitest run test/e2e --maxWorkers=1"
  },
  "keywords": [
    "nestjs",
    "node",
    "typescript",
    "cli",
    "backend",
    "code-generation",
    "developer-tools"
  ],
  "license": "MIT",
  "packageManager": "pnpm@11.21.0",
  "dependencies": {
    "@clack/prompts": "1.7.0",
    "commander": "15.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
