export interface AppConfig {
  readonly nodeEnv: string;
  readonly port: number;
  {{redisConfigType}}
  {{authConfigType}}
}

export function loadConfiguration(): AppConfig {
  return {
    nodeEnv:
      process.env.NODE_ENV ?? 'development',

    port: Number(
      process.env.PORT ?? 3000,
    ),

    {{redisConfig}}

    {{authConfig}}
  };
}