import { z } from 'zod';

/**
 * A string variable that must be present and non-empty. Produces
 * "NAME is required" instead of zod's generic type error.
 */
function requiredString(name: string) {
  return z
    .string({
      error: (issue) =>
        issue.input === undefined
          ? `${name} is required`
          : `${name} must be a string`,
    })
    .trim()
    .min(1, {
      error: `${name} must not be empty`,
      abort: true,
    });
}

const EnvironmentSchema = z.object({
  NODE_ENV: z
    .enum([
      'development',
      'test',
      'production',
    ])
    .default('development'),

  PORT: z.coerce
    .number()
    .int()
    .min(1)
    .max(65535)
    .default(3000),

  LOG_LEVEL: z
    .enum([
      'fatal',
      'error',
      'warn',
      'info',
      'debug',
      'trace',
      'silent',
    ])
    .default('info'),

  CORS_ORIGINS: z.string().default(''),

  THROTTLE_LIMIT: z.coerce
    .number()
    .int()
    .min(1)
    .default(100),

  THROTTLE_TTL_MS: z.coerce
    .number()
    .int()
    .min(1)
    .default(60000),

  {{databaseEnvSchema}}

  {{redisEnvSchema}}

  {{authEnvSchema}}
});

export type Environment = z.infer<
  typeof EnvironmentSchema
>;

export function validateEnvironment(
  config: Record<string, unknown>,
): Environment {
  const result =
    EnvironmentSchema.safeParse(config);

  if (!result.success) {
    const problems = result.error.issues
      .map((issue) => {
        const name = issue.path.join('.');

        // Messages written by requiredString() already name the variable.
        return name && !issue.message.startsWith(name)
          ? `  - ${name}: ${issue.message}`
          : `  - ${issue.message}`;
      })
      .join('\n');

    throw new Error(
      `Invalid environment configuration:\n${problems}\n\n` +
        'Set these in your .env file or the process environment (see .env.example).',
    );
  }

  return result.data;
}